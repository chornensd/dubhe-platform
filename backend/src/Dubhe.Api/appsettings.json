{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dubhe-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=dubhe;Username=dubhe;Password=REPLACE_ME"
  },
  "Jwt": {
    "Issuer": "Dubhe",
    "Audience": "DubheClients",
    "SigningKey": "REPLACE_ME_WITH_AT_LEAST_32_CHARACTERS_KEY",
    "PcAccessTokenHours": 8,
    "MobileAccessTokenHours": 2,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Database": {
    "AutoMigrate": true
  },
  "Pricing": {
    "BaseFee": 10,
    "PerKm": 2.5,
    "PerKg": 1.5,
    "AirspaceFee": 2,
    "UrgentSurchargeRate": 0.5,
    "MaxDiscountRate": 0.5,
    "MinDistanceKm": 1,
    "FlightSpeedKmh": 60
  },
  "Settlement": {
    "CommissionRate": 0.1
  },
  "Airspace": {
    "DeviationThresholdKm": 1.0,
    "ViolationDedupeMinutes": 5,
    "MockAtsCenterLat": 30.06,
    "MockAtsCenterLng": 120.06,
    "MockAtsRadiusKm": 2.0,
    "MockAtsValidHours": 12
  },
  "Backups": {
    "Directory": "backups"
  },
  "Seed": {
    "AdminUsername": "admin",
    "AdminPhone": "13800000000",
    "AdminPassword": ""
  },
  "AllowedHosts": "*"
}
